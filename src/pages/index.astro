---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { projects } from '../data/projects.js';

const skills = [
	"Odoo (Framework)", "Python", "JavaScript", "PostgreSQL", "Docker", "Git", "HTML & CSS", "XML"
];

const softSkills = [
	"Resolución de Problemas", "Aprendizaje Continuo", "Pensamiento Crítico", "Iniciativa y Proactividad", "Organización y Planificación", "Trabajo en Equipo"
];
---

<BaseLayout title="Euclides Ollarves | Especialista Odoo">
	<ThemeToggle />
	
	<main class="max-w-4xl mx-auto px-6 py-20 space-y-32">
		<!-- Hero Section -->
		<section class="flex flex-col md:flex-row items-center gap-10">
			<div class="relative group">
				<div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
				<div class="relative w-48 h-48 overflow-hidden rounded-full border-4 border-white dark:border-zinc-800 bg-white shadow-xl">
					<img 
						src="/profile/profile.jpeg" 
						alt="Euclides Ollarves" 
						class="w-full h-full object-cover"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="hidden w-full h-full items-center justify-center bg-zinc-100 text-zinc-400 font-bold text-4xl">
						EO
					</div>
				</div>
			</div>
			
			<div class="flex-1 text-center md:text-left space-y-4">
				<h1 class="text-4xl md:text-6xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-zinc-900 to-zinc-600 dark:from-zinc-100 dark:to-zinc-500">
					Euclides Ollarves
				</h1>
				<p class="text-xl md:text-2xl text-zinc-600 dark:text-zinc-400 font-medium">
					Ingeniero en Informática | <span class="text-indigo-500">Especialista Odoo</span>
				</p>
				<div class="flex flex-wrap justify-center md:justify-start gap-4 pt-4">
					<a href="mailto:euclidesollarves@gmail.com" class="px-6 py-2 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium transition-all shadow-lg shadow-indigo-500/20 flex items-center gap-2 group">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						Contactar
					</a>
					<a href="https://github.com/euclides-ollarves" target="_blank" rel="noopener noreferrer" class="px-6 py-2 rounded-full border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						GitHub
					</a>
					<a href="https://linkedin.com/in/euclides-ollarves" target="_blank" rel="noopener noreferrer" class="px-6 py-2 rounded-full border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
						LinkedIn
					</a>
				</div>
			</div>
		</section>

		<!-- Profile Bio -->
		<section class="space-y-6">
			<h2 class="text-2xl font-bold flex items-center gap-2">
				<span class="w-8 h-px bg-indigo-500"></span> Perfil Profesional
			</h2>
			<div class="space-y-4 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
				<p>
					Ingeniero en Informática con <strong class="text-indigo-500 font-semibold">3 años de experiencia especializado en Odoo</strong>. Experto en <strong>Python</strong> para lógica de negocio compleja y <strong>PostgreSQL</strong> para gestión de bases de datos.
				</p>
				<p>
					Mi enfoque combina la capacidad técnica con una visión funcional en módulos críticos como Ventas, Compras, CRM, Contabilidad e Inventario, permitiendo transformar procesos manuales en flujos automatizados que potencian la eficiencia organizacional.
				</p>
			</div>
		</section>

		<!-- Skills -->
		<section class="grid md:grid-cols-2 gap-12">
			<div class="space-y-6">
				<h2 class="text-2xl font-bold flex items-center gap-2">
					<span class="w-8 h-px bg-indigo-500"></span> Habilidades Técnicas
				</h2>
				<div class="flex flex-wrap gap-2">
					{skills.map(skill => (
						<span class="px-4 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 text-sm font-medium border border-indigo-100 dark:border-indigo-500/20">
							{skill}
						</span>
					))}
				</div>
			</div>
			
			<div class="space-y-6">
				<h2 class="text-2xl font-bold flex items-center gap-2">
					<span class="w-8 h-px bg-indigo-500"></span> Soft Skills
				</h2>
				<div class="flex flex-wrap gap-2 text-zinc-600 dark:text-zinc-400">
					{softSkills.map(skill => (
						<span class="px-3 py-1 bg-zinc-100 dark:bg-zinc-900 rounded-md text-sm border border-zinc-200 dark:border-zinc-800">
							{skill}
						</span>
					))}
				</div>
			</div>
		</section>

		<!-- Experience & Education -->
		<section class="grid md:grid-cols-2 gap-16">
			<div class="space-y-10">
				<h2 class="text-2xl font-bold flex items-center gap-2">
					<span class="w-8 h-px bg-indigo-500"></span> Experiencia
				</h2>
				
				<div class="space-y-8">
					<div class="relative pl-8 border-l border-zinc-200 dark:border-zinc-800">
						<div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-indigo-500"></div>
						<div class="space-y-1">
							<span class="text-xs font-mono text-zinc-500">Nov 2025 — Actualidad</span>
							<h3 class="text-lg font-bold">Programador Principal</h3>
							<p class="text-sm font-medium text-indigo-500">TECNODOO C.A</p>
							<p class="text-sm text-zinc-600 dark:text-zinc-400">Logalización v18 y dualidad de monedas.</p>
						</div>
					</div>
					
					<div class="relative pl-8 border-l border-zinc-200 dark:border-zinc-800">
						<div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-zinc-300 dark:bg-zinc-700"></div>
						<div class="space-y-1">
							<span class="text-xs font-mono text-zinc-500">2023 — 2025</span>
							<h3 class="text-lg font-bold">Programador Junior</h3>
							<p class="text-sm font-medium text-indigo-500">AGRORUEDAS CHAKAO</p>
							<p class="text-sm text-zinc-600 dark:text-zinc-400">Implementación ERP y addons personalizados.</p>
						</div>
					</div>
				</div>
			</div>

			<div class="space-y-10">
				<h2 class="text-2xl font-bold flex items-center gap-2">
					<span class="w-8 h-px bg-indigo-500"></span> Formación
				</h2>
				
				<div class="space-y-8">
					<div class="relative pl-8 border-l border-zinc-200 dark:border-zinc-800">
						<div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-indigo-500"></div>
						<div class="space-y-1">
							<span class="text-xs font-mono text-zinc-500">2013 — 2019</span>
							<h3 class="text-lg font-bold">Ingeniería en Informática</h3>
							<p class="text-sm font-medium text-indigo-500">UPTP Juan de Jesús Montilla</p>
							<p class="text-sm text-zinc-600 dark:text-zinc-400">Turen, Portuguesa.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Projects -->
		<section class="space-y-10">
			<h2 class="text-2xl font-bold flex items-center gap-2">
				<span class="w-8 h-px bg-indigo-500"></span> Proyectos Odoo
			</h2>
			
			<div class="grid sm:grid-cols-2 gap-8">
				{projects.map(project => (
					<a href={`/projects/${project.slug}`} class="group relative bg-white dark:bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 block">
						<div class="aspect-video overflow-hidden bg-zinc-100 dark:bg-zinc-800">
							<img src={project.image} alt={project.title} class="w-full h-full object-contain grayscale group-hover:grayscale-0 transition-all duration-500" />
						</div>
						<div class="p-6 space-y-4">
							<h3 class="text-lg font-bold group-hover:text-indigo-500 transition-colors">{project.title}</h3>
							<p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2">{project.description}</p>
							<div class="flex flex-wrap gap-2">
								{project.tags.map(tag => (
									<span class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500">
										{tag}
									</span>
								))}
							</div>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- Footer -->
		<footer class="pt-20 pb-10 border-t border-zinc-200 dark:border-zinc-800 text-center space-y-4">
			<p class="text-zinc-500 text-sm">© {new Date().getFullYear()} Euclides Ollarves. Desarrollado con Astro & Tailwind.</p>
		</footer>
	</main>
</BaseLayout>

<style>
	/* Custom scrollbar for dark mode */
	:global(.dark) ::-webkit-scrollbar {
		width: 10px;
	}
	:global(.dark) ::-webkit-scrollbar-track {
		background: #09090b;
	}
	:global(.dark) ::-webkit-scrollbar-thumb {
		background: #27272a;
		border-radius: 5px;
	}
	:global(.dark) ::-webkit-scrollbar-thumb:hover {
		background: #3f3f46;
	}
</style>
