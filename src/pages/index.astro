---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { projects } from '../data/projects.js';

const skillCategories = [
	{
		title: "Ecosistema Odoo & Negocio",
		icon: "odoo",
		badgeColor: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20",
		skills: ["Odoo Framework (v13–v19)", "Addons Personalizados", "Reportes QWeb XML", "Modelos Relacionales", "Localización SENIAT", "Dualidad Multimoneda", "Costeo de Importaciones"]
	},
	{
		title: "Backend & Bases de Datos",
		icon: "backend",
		badgeColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
		skills: ["Python", "PostgreSQL (Optimización)", "MySQL", "APIs REST", "Webhooks", "JSON-RPC", "Arquitectura de Software"]
	},
	{
		title: "Inteligencia Artificial & Automatización",
		icon: "ai",
		badgeColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
		skills: ["AI Agents", "Prompt Engineering", "APIs LLMs (OpenAI, Claude, Gemini, Groq)", "Web Scraping", "AntiGravity IDE", "Desarrollo Acelerado"]
	},
	{
		title: "DevOps, Infraestructura & Frontend",
		icon: "devops",
		badgeColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
		skills: ["Docker & Docker Compose", "Coolify", "Ubuntu Linux Server", "GitHub Actions CI/CD", "Cloudflare Tunnels", "JavaScript", "Tailwind CSS", "Bootstrap"]
	}
];

const softSkills = [
	"Resolución Analítica de Problemas",
	"Pensamiento Crítico y Sistémico",
	"Aprendizaje Acelerado de Tecnologías",
	"Iniciativa & Proactividad Técnica",
	"Planificación y Organización Ágil",
	"Comunicación Clara y Trabajo en Equipo"
];

const metrics = [
	{ value: "+3 Años", label: "Especialización en Odoo ERP" },
	{ value: "v13 – v19", label: "Versiones ERP Dominadas" },
	{ value: "100%", label: "Cumplimiento SENIAT & BCV" },
	{ value: "IA & DevOps", label: "Automatización & Contenedores" }
];
---

<BaseLayout title="Euclides Ollarves | Odoo ERP Developer & AI Solutions">
	<ThemeToggle />

	<!-- Navigation Bar -->
	<header class="sticky top-0 z-40 backdrop-blur-md bg-white/70 dark:bg-[#090b10]/75 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
		<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
			<a href={`${import.meta.env.BASE_URL}/`} class="flex items-center gap-3 group">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white font-bold flex items-center justify-center text-sm shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform">
					EO
				</div>
				<span class="font-bold text-lg tracking-tight group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
					Euclides Ollarves
				</span>
			</a>

			<nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-600 dark:text-zinc-400">
				<a href="#perfil" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Perfil</a>
				<a href="#especialidades" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Especialidades</a>
				<a href="#habilidades" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Habilidades</a>
				<a href="#experiencia" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Experiencia</a>
				<a href="#proyectos" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Proyectos</a>
				<a href="#contacto" class="px-4 py-1.5 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-sm transition-all hover:shadow-indigo-500/25">
					Hablemos
				</a>
			</nav>
		</div>
	</header>

	<main class="max-w-5xl mx-auto px-6 py-12 md:py-20 space-y-28 md:space-y-36">
		
		<!-- Hero Section -->
		<section class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 pt-4">
			<div class="flex-1 text-center md:text-left space-y-6">
				<!-- Status Badge -->
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold tracking-wide">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
					</span>
					Disponible para nuevos proyectos & consultoría
				</div>

				<!-- Main Headline -->
				<div class="space-y-3">
					<h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white leading-[1.1]">
						Desarrollo <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-500 dark:from-indigo-400 dark:via-purple-400 dark:to-indigo-300">Odoo ERP</span> de Alto Nivel con <span class="text-zinc-900 dark:text-zinc-100">IA Aplicada</span>
					</h1>
					<p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-300 font-normal leading-relaxed max-w-2xl">
						Hola, soy <strong>Euclides Ollarves</strong>. Ingeniero en Informática con más de 3 años de experiencia especializado en la creación de módulos, localización fiscal venezolana y automatización de procesos mediante agentes autónomos de Inteligencia Artificial.
					</p>
				</div>

				<!-- Call to Action Buttons -->
				<div class="flex flex-wrap justify-center md:justify-start items-center gap-3 pt-2">
					<a 
						href="mailto:euclidesollarves@gmail.com" 
						class="px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold transition-all shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 flex items-center gap-2 group"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:rotate-12 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						Contactar Ahora
					</a>
					<a 
						href="https://wa.me/584121512702" 
						target="_blank" 
						rel="noopener noreferrer" 
						class="px-5 py-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold transition-all flex items-center gap-2 hover:-translate-y-0.5"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						WhatsApp
					</a>
					<a 
						href="https://linkedin.com/in/euclides-ollarves" 
						target="_blank" 
						rel="noopener noreferrer" 
						class="px-5 py-3 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all font-semibold flex items-center gap-2 hover:-translate-y-0.5"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
						LinkedIn
					</a>
					<a 
						href="https://github.com/euclides-ollarves" 
						target="_blank" 
						rel="noopener noreferrer" 
						class="px-5 py-3 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all font-semibold flex items-center gap-2 hover:-translate-y-0.5"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-700 dark:text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						GitHub
					</a>
				</div>
			</div>

			<!-- Profile Picture with Glowing Ring -->
			<div class="relative group">
				<div class="absolute -inset-1.5 bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 rounded-3xl blur-md opacity-40 group-hover:opacity-75 transition duration-700"></div>
				<div class="relative w-52 h-52 md:w-64 md:h-64 rounded-3xl overflow-hidden border-2 border-white/80 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xl">
					<img 
						src={`${import.meta.env.BASE_URL}/profile/profile.png`} 
						alt="Euclides Ollarves - Odoo Developer" 
						class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
						onerror="this.src=`${import.meta.env.BASE_URL}/profile/profile.jpeg`;"
					/>
				</div>
			</div>
		</section>

		<!-- Metrics Grid Bar -->
		<section class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
			{metrics.map(metric => (
				<div class="p-6 rounded-2xl bg-white/60 dark:bg-zinc-900/60 backdrop-blur-sm border border-zinc-200/80 dark:border-zinc-800/80 text-center hover:border-indigo-500/40 transition-colors shadow-sm">
					<span class="block text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400">
						{metric.value}
					</span>
					<span class="block text-xs md:text-sm font-medium text-zinc-600 dark:text-zinc-400 mt-1">
						{metric.label}
					</span>
				</div>
			))}
		</section>

		<!-- Pillars / Value Proposition -->
		<section id="especialidades" class="space-y-10">
			<div class="space-y-3 text-center md:text-left">
				<div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider">
					<span class="w-2 h-2 rounded-full bg-indigo-500"></span> Propuesta de Valor
				</div>
				<h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">
					Pilares de Especialización Técnica
				</h2>
				<p class="text-zinc-600 dark:text-zinc-400 max-w-2xl">
					Integrando la estabilidad del ERP corporativo con metodologías modernas de automatización asistida por Inteligencia Artificial.
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-6">
				<!-- Card 1 -->
				<div class="p-8 rounded-3xl bg-white dark:bg-zinc-900/70 border border-zinc-200/80 dark:border-zinc-800/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
					</div>
					<h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">Desarrollo Odoo Backend</h3>
					<p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
						Diseño de addons a medida en Python, extensión de modelos relacionales, lógica contable/fiscal, vistas XML y reportes QWeb optimizados para alto rendimiento en PostgreSQL.
					</p>
					<ul class="text-xs space-y-2 text-zinc-500 font-medium pt-2">
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Versiones 13 a 19 (Community & Enterprise)</li>
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Localización Venezolana (SENIAT, ISLR, IVA)</li>
					</ul>
				</div>

				<!-- Card 2 -->
				<div class="p-8 rounded-3xl bg-white dark:bg-zinc-900/70 border border-zinc-200/80 dark:border-zinc-800/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
					</div>
					<h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">IA & Agentes Autónomos</h3>
					<p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
						Implementación de pipelines acelerados y asistentes inteligentes. Conexión de modelos LLM (OpenAI, Claude, Groq, Gemini) con Odoo para procesamiento automático de datos empresariales.
					</p>
					<ul class="text-xs space-y-2 text-zinc-500 font-medium pt-2">
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Flujos asistidos con AntiGravity IDE & Claude</li>
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Web scraping & automatización de consultas</li>
					</ul>
				</div>

				<!-- Card 3 -->
				<div class="p-8 rounded-3xl bg-white dark:bg-zinc-900/70 border border-zinc-200/80 dark:border-zinc-800/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
					</div>
					<h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">DevOps & Despliegue Ágil</h3>
					<p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
						Entornos de desarrollo y producción reproducibles basados en contenedores Docker y Docker Compose, control de versiones en GitHub y despliegues orquestados con Coolify.
					</p>
					<ul class="text-xs space-y-2 text-zinc-500 font-medium pt-2">
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Servidores Ubuntu Linux & Backups automáticos</li>
						<li class="flex items-center gap-2"><span class="text-indigo-500">✓</span> Conexiones seguras con Cloudflare Tunnels & ngrok</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Bio Section -->
		<section id="perfil" class="p-8 md:p-12 rounded-3xl bg-gradient-to-br from-indigo-500/5 via-purple-500/5 to-transparent border border-zinc-200/80 dark:border-zinc-800/80 space-y-6">
			<div class="flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider">
				<span class="w-2 h-2 rounded-full bg-indigo-500"></span> Trayectoria Profesional
			</div>
			<h2 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-zinc-100">
				Perfil Profesional & Filosofía de Trabajo
			</h2>
			<div class="space-y-4 text-base md:text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
				<p>
					Como <strong>Ingeniero en Informática con más de 3 años de especialización en Odoo ERP</strong>, he liderado implementaciones técnicas y funcionales que transforman operaciones complejas en sistemas automatizados y escalables. Mi experiencia abarca desde la versión 13 hasta la 19, cubriendo modelos de negocio críticos como <strong>Ventas, Compras, CRM, Facturación, Inventario y Contabilidad Fiscal</strong>.
				</p>
				<p>
					Mi diferenciador radica en la integración temprana de la <strong>Inteligencia Artificial</strong> en el ciclo de vida del software: empleo agentes de IA para refactorizar código de forma limpia, acelerar pruebas unitarias y conectar modelos de lenguaje con la base de datos empresarial de Odoo para habilitar procesos de negocio predictivos y automáticos.
				</p>
			</div>
		</section>

		<!-- Categorized Technical Skills -->
		<section id="habilidades" class="space-y-10">
			<div class="space-y-3 text-center md:text-left">
				<div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider">
					<span class="w-2 h-2 rounded-full bg-indigo-500"></span> Stack Tecnológico
				</div>
				<h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">
					Habilidades Técnicas & Herramientas
				</h2>
				<p class="text-zinc-600 dark:text-zinc-400 max-w-2xl">
					Dominio estructurado de herramientas backend, framework Odoo, arquitectura de datos y tecnologías de despliegue.
				</p>
			</div>

			<!-- Grid of categorized skills -->
			<div class="grid md:grid-cols-2 gap-6">
				{skillCategories.map(cat => (
					<div class="p-6 md:p-8 rounded-3xl bg-white dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800/80 shadow-sm space-y-4">
						<div class="flex items-center justify-between">
							<h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{cat.title}</h3>
						</div>
						<div class="flex flex-wrap gap-2 pt-2">
							{cat.skills.map(skill => (
								<span class={`px-3.5 py-1.5 rounded-xl text-xs font-medium border ${cat.badgeColor}`}>
									{skill}
								</span>
							))}
						</div>
					</div>
				))}
			</div>

			<!-- Soft Skills & Competencies -->
			<div class="p-6 md:p-8 rounded-3xl bg-zinc-100/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800 space-y-4">
				<h3 class="text-base font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
					Habilidades Blandas & Metodologías
				</h3>
				<div class="flex flex-wrap gap-2 text-zinc-600 dark:text-zinc-400">
					{softSkills.map(skill => (
						<span class="px-3 py-1 bg-white dark:bg-zinc-800 rounded-lg text-xs font-medium border border-zinc-200/60 dark:border-zinc-700/60 shadow-2xs">
							{skill}
						</span>
					))}
				</div>
			</div>
		</section>

		<!-- Experience & Education Timeline -->
		<section id="experiencia" class="space-y-12">
			<div class="space-y-3 text-center md:text-left">
				<div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider">
					<span class="w-2 h-2 rounded-full bg-indigo-500"></span> Historial
				</div>
				<h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">
					Experiencia Laboral & Formación
				</h2>
			</div>

			<div class="grid md:grid-cols-3 gap-10">
				<!-- Experience (2 cols) -->
				<div class="md:col-span-2 space-y-8">
					<h3 class="text-xl font-bold flex items-center gap-2 text-zinc-800 dark:text-zinc-200">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
						Trayectoria en Desarrollo
					</h3>

					<div class="space-y-8 pl-4 border-l-2 border-indigo-500/20">
						<!-- Job 1 -->
						<div class="relative pl-6 space-y-2 group">
							<div class="absolute -left-[23px] top-1.5 w-4 h-4 rounded-full bg-indigo-600 ring-4 ring-indigo-500/20"></div>
							<div class="flex flex-wrap items-center justify-between gap-2">
								<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">
